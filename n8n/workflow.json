{
  "name": "Kreditton — Preevaluación Hipotecaria v2",
  "_descripcion": "Arquitectura v2: JotForm captura solo datos externos. Kreditton completa score, reportes y documentación internamente antes de evaluar.",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook JotForm",
      "type": "n8n-nodes-base.webhook",
      "position": [200, 300],
      "parameters": {
        "path": "kreditton-prospecto",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "_nota": "JotForm envía SOLO datos externos del cliente/aliado. Score, reportes y documentación los completa Kreditton internamente."
    },
    {
      "id": "2",
      "name": "Normalizar datos externos",
      "type": "n8n-nodes-base.set",
      "position": [420, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "tipo_cliente",      "value": "={{ $json.body.q3_tipoDeCliente ?? 'B2C' }}" },
            { "name": "nombre_aliado",     "value": "={{ $json.body.q4_nombreAliado ?? '' }}" },
            { "name": "tipo_documento",    "value": "={{ $json.body.q5_tipoDocumento }}" },
            { "name": "numero_documento",  "value": "={{ $json.body.q6_numeroDocumento }}" },
            { "name": "nombre_completo",   "value": "={{ $json.body.q7_nombreCompleto }}" },
            { "name": "telefono",          "value": "={{ $json.body.q8_telefono }}" },
            { "name": "email",             "value": "={{ $json.body.q9_email }}" },
            { "name": "perfil_financiero", "value": "={{ $json.body.q10_perfilFinanciero }}" }
          ],
          "number": [
            { "name": "ingresos", "value": "={{ Number($json.body.q11_ingresos) }}" }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Verificar duplicado",
      "type": "n8n-nodes-base.httpRequest",
      "position": [640, 300],
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:3001/api/prospectos/buscar?numero_documento={{ encodeURIComponent($json.numero_documento) }}",
        "_nota": "Retorna null si es nuevo, o el prospecto existente si ya está registrado"
      }
    },
    {
      "id": "4",
      "name": "¿Es duplicado?",
      "type": "n8n-nodes-base.if",
      "position": [860, 300],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.id !== undefined && $json.id !== null }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "5a",
      "name": "Registrar prospecto nuevo",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1080, 200],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/prospectos",
        "body": {
          "contentType": "json",
          "jsonParameters": true,
          "bodyParametersJson": "={{ JSON.stringify({ tipo_cliente: $('Normalizar datos externos').item.json.tipo_cliente, nombre_aliado: $('Normalizar datos externos').item.json.nombre_aliado, tipo_documento: $('Normalizar datos externos').item.json.tipo_documento, numero_documento: $('Normalizar datos externos').item.json.numero_documento, nombre_completo: $('Normalizar datos externos').item.json.nombre_completo, telefono: $('Normalizar datos externos').item.json.telefono, email: $('Normalizar datos externos').item.json.email, perfil_financiero: $('Normalizar datos externos').item.json.perfil_financiero, ingresos: $('Normalizar datos externos').item.json.ingresos }) }}"
        }
      }
    },
    {
      "id": "5b",
      "name": "Prospecto existente (ignorar o actualizar)",
      "type": "n8n-nodes-base.noOp",
      "position": [1080, 420],
      "_nota": "Si ya existe, no se crea duplicado. El equipo Kreditton agrega la nueva evaluación desde el expediente interno."
    },
    {
      "id": "6",
      "name": "Registrar en Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [1300, 200],
      "parameters": {
        "operation": "create",
        "application": "YOUR_AIRTABLE_BASE_ID",
        "table": "Prospectos",
        "fields": {
          "Tipo cliente":        "={{ $('Normalizar datos externos').item.json.tipo_cliente }}",
          "Nombre aliado":       "={{ $('Normalizar datos externos').item.json.nombre_aliado }}",
          "Tipo documento":      "={{ $('Normalizar datos externos').item.json.tipo_documento }}",
          "Número documento":    "={{ $('Normalizar datos externos').item.json.numero_documento }}",
          "Nombre completo":     "={{ $('Normalizar datos externos').item.json.nombre_completo }}",
          "Teléfono":            "={{ $('Normalizar datos externos').item.json.telefono }}",
          "Email":               "={{ $('Normalizar datos externos').item.json.email }}",
          "Perfil financiero":   "={{ $('Normalizar datos externos').item.json.perfil_financiero }}",
          "Ingresos":            "={{ $('Normalizar datos externos').item.json.ingresos }}",
          "Estado":              "nuevo",
          "Fecha registro":      "={{ new Date().toISOString() }}",
          "ID sistema":          "={{ $json.id }}"
        },
        "_nota": "Score crédito, reportes, documentación y evaluación se completan desde el sistema interno de Kreditton, NO desde JotForm."
      }
    },
    {
      "id": "7",
      "name": "Notificar equipo Kreditton",
      "type": "n8n-nodes-base.emailSend",
      "position": [1520, 200],
      "parameters": {
        "fromEmail": "sistema@kreditton.com",
        "toEmail": "operaciones@kreditton.com",
        "subject": "=[KREDITTON] Nuevo prospecto pendiente de evaluar: {{ $('Normalizar datos externos').item.json.nombre_completo }}",
        "emailType": "html",
        "message": "=<div style='font-family:sans-serif;max-width:600px'>\n<div style='background:#111;padding:20px;border-radius:8px 8px 0 0'>\n<h2 style='color:#F5C518;margin:0'>Kreditton — Nuevo prospecto</h2>\n<p style='color:#9ca3af;margin:4px 0 0'>Requiere preevaluación interna</p>\n</div>\n<div style='border:1px solid #e5e7eb;border-top:none;padding:24px;border-radius:0 0 8px 8px'>\n<table width='100%' cellpadding='6'>\n<tr><td style='color:#6b7280;width:40%'>Nombre</td><td><b>{{ $('Normalizar datos externos').item.json.nombre_completo }}</b></td></tr>\n<tr><td style='color:#6b7280'>Documento</td><td>{{ $('Normalizar datos externos').item.json.tipo_documento }} {{ $('Normalizar datos externos').item.json.numero_documento }}</td></tr>\n<tr><td style='color:#6b7280'>Origen</td><td>{{ $('Normalizar datos externos').item.json.tipo_cliente }}{{ $('Normalizar datos externos').item.json.nombre_aliado ? ' — ' + $('Normalizar datos externos').item.json.nombre_aliado : '' }}</td></tr>\n<tr><td style='color:#6b7280'>Perfil</td><td>{{ $('Normalizar datos externos').item.json.perfil_financiero }}</td></tr>\n<tr><td style='color:#6b7280'>Ingresos</td><td>$ {{ Number($('Normalizar datos externos').item.json.ingresos).toLocaleString('es-CO') }}</td></tr>\n<tr><td style='color:#6b7280'>Contacto</td><td>{{ $('Normalizar datos externos').item.json.email }} | {{ $('Normalizar datos externos').item.json.telefono }}</td></tr>\n</table>\n<hr style='margin:20px 0'>\n<p style='background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:16px;color:#92400e'>\n<b>Acción requerida:</b> Consultar score en Datacrédito/TransUnion, verificar reportes negativos y estado de documentación. Luego ejecutar la preevaluación desde el sistema interno.\n</p>\n<a href='http://localhost:5173/prospectos/{{ $json.id }}' style='display:inline-block;background:#111;color:#F5C518;font-weight:bold;padding:10px 20px;border-radius:8px;text-decoration:none;margin-top:8px'>Abrir expediente →</a>\n</div>\n</div>"
      }
    },
    {
      "id": "8",
      "name": "Respuesta webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1740, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"mensaje\": \"Prospecto registrado. Pendiente de preevaluación interna.\", \"prospecto_id\": {{ $('Registrar prospecto nuevo').item.json.id ?? 'duplicado' }} }"
      }
    }
  ],
  "connections": {
    "Webhook JotForm":                { "main": [[{ "node": "Normalizar datos externos",       "type": "main", "index": 0 }]] },
    "Normalizar datos externos":      { "main": [[{ "node": "Verificar duplicado",             "type": "main", "index": 0 }]] },
    "Verificar duplicado":            { "main": [[{ "node": "¿Es duplicado?",                  "type": "main", "index": 0 }]] },
    "¿Es duplicado?": {
      "main": [
        [{ "node": "Prospecto existente (ignorar o actualizar)", "type": "main", "index": 0 }],
        [{ "node": "Registrar prospecto nuevo",                  "type": "main", "index": 0 }]
      ]
    },
    "Registrar prospecto nuevo":      { "main": [[{ "node": "Registrar en Airtable",           "type": "main", "index": 0 }]] },
    "Registrar en Airtable":          { "main": [[{ "node": "Notificar equipo Kreditton",       "type": "main", "index": 0 }]] },
    "Notificar equipo Kreditton":     { "main": [[{ "node": "Respuesta webhook",               "type": "main", "index": 0 }]] },
    "Prospecto existente (ignorar o actualizar)": { "main": [[{ "node": "Respuesta webhook",   "type": "main", "index": 0 }]] }
  }
}
